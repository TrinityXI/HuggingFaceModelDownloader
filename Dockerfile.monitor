# Combined Monitor Dockerfile (Flask API + Next.js UI)

# Stage 1: Build Next.js UI
FROM node:18-alpine AS ui-builder

WORKDIR /app/ui

# Install UI dependencies
COPY monitor/ui/package.json ./
RUN npm install

# Build UI
COPY monitor/ui .
ARG NEXT_PUBLIC_API_URL=/api
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build

# Stage 2: Final image with both API and UI
FROM python:3.11-alpine

# Install Node.js for running Next.js and bash for script
RUN apk add --no-cache nodejs npm bash curl netcat-openbsd

WORKDIR /app

# Install Python dependencies
COPY monitor/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy Flask API and related modules
COPY monitor/api_service.py ./
COPY Data-discover/mysql_queue.py ./
COPY Data-discover/dataset_db.py ./

# Copy Next.js built files
COPY --from=ui-builder /app/ui/.next/standalone ./ui/
COPY --from=ui-builder /app/ui/.next/static ./ui/.next/static
COPY --from=ui-builder /app/ui/public ./ui/public

# Create startup script that properly handles both services
COPY <<'EOF' /app/start.sh
#!/bin/bash
set -e

# Start API service in background
echo "Starting Flask API on port 8080..."
python api_service.py &
API_PID=$!

# Wait for API to be ready
echo "Waiting for API to be ready..."
for i in {1..30}; do
    if nc -z 127.0.0.1 8080; then
        echo "API is ready!"
        break
    fi
    
    if ! kill -0 $API_PID > /dev/null 2>&1; then
        echo "Flask API failed to start!"
        wait $API_PID
        exit 1
    fi
    
    echo "Waiting for API... ($i/30)"
    sleep 1
done

# Start Next.js in foreground
echo "Starting Next.js UI on port 3000..."
cd ui && exec node server.js
EOF

RUN chmod +x /app/start.sh

# Expose ports
EXPOSE 8080 3000

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV MONITOR_HOST=0.0.0.0
ENV MONITOR_PORT=8080

# Start both services
CMD ["/app/start.sh"]