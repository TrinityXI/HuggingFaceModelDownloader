# 消费者服务 Dockerfile（支持多架构）
# 消费者需要 Python 环境来运行 consumer_docker.py，并调用 Docker

FROM python:3.11-slim

# 构建参数：支持多架构
ARG TARGETOS=linux
ARG TARGETARCH=amd64

# 安装必要的运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

# 创建非 root 用户
RUN groupadd -r hfuser && useradd -r -g hfuser hfuser

# 将用户添加到 docker 组（以便能够调用 Docker）
RUN usermod -aG docker hfuser || true

# 设置工作目录
WORKDIR /app

# 安装依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 复制源代码
COPY consumer_docker.py dataset_db.py ./

# 创建日志目录
RUN mkdir -p /app/logs && \
    chown -R hfuser:hfuser /app

# 设置权限
RUN chmod +x consumer_docker.py

# 切换到非 root 用户
USER hfuser

# 环境变量
ENV PYTHONUNBUFFERED=1
ENV CONSUMER_DB=datasets.db
ENV CONSUMER_OUTPUT=/data
ENV CONSUMER_DOCKER_IMAGE=huggingface-downloader:latest
ENV CONSUMER_ENDPOINT=https://hf-mirror.com
ENV CONSUMER_WORKERS=1
ENV CONSUMER_MAX_ACTIVE=2
ENV CONSUMER_CONNECTIONS=4

# 运行消费者服务（使用环境变量）
CMD python consumer_docker.py \
    --db ${CONSUMER_DB} \
    --output ${CONSUMER_OUTPUT} \
    --docker-image ${CONSUMER_DOCKER_IMAGE} \
    --endpoint ${CONSUMER_ENDPOINT} \
    --workers ${CONSUMER_WORKERS} \
    --max-active ${CONSUMER_MAX_ACTIVE} \
    --connections ${CONSUMER_CONNECTIONS}

