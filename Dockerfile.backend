# Backend Service Dockerfile

# 使用平台匹配的基础镜像
FROM docker.m.daocloud.io/python:3.11-alpine

# 安装必要的运行时依赖
RUN apk add --no-cache ca-certificates curl

# 创建非 root 用户
RUN addgroup -S hfuser && adduser -S hfuser -G hfuser

# 设置工作目录
WORKDIR /app

# 复制依赖文件
COPY backend/requirements.txt .

# 安装 Python 依赖
RUN pip install --no-cache-dir -r requirements.txt

# 复制 backend 源代码 (包括 lib 目录)
COPY backend/ .

# 创建日志目录和数据目录
RUN mkdir -p /app/logs /app/data && \
    chown -R hfuser:hfuser /app && \
    chmod -R 755 /app/logs && \
    chmod 777 /app/logs

# 设置权限
RUN chmod +x producer.py

# 环境变量
ENV PYTHONUNBUFFERED=1
ENV RABBITMQ_HOST=rabbitmq
ENV RABBITMQ_PORT=5672
ENV RABBITMQ_USER=admin
ENV RABBITMQ_PASSWORD=password123
ENV RABBITMQ_VHOST=/
ENV RABBITMQ_QUEUE_NAME=hf_download_queue
ENV RABBITMQ_DLQ_NAME=hf_download_dlq
ENV HF_ENDPOINT=https://hf-mirror.com
ENV PRODUCER_INTERVAL=3600
ENV PRODUCER_DAYS=7
ENV PRODUCER_LIMIT=50
ENV PRODUCER_TIMEZONE_OFFSET=8
ENV PRODUCER_USE_CREATED_AT=false
ENV PRODUCER_AUTO_LIMIT=true
ENV REDIS_HOST=redis
ENV REDIS_PORT=6379
ENV REDIS_DB=0
ENV REDIS_CONFIG_KEY=hf_producer_config

# 环境变量（HTTP API）
ENV PRODUCER_HOST=0.0.0.0
ENV PRODUCER_PORT=8000

# 飞书机器人配置（可选）
ENV FEISHU_WEBHOOK_URL=""
ENV FEISHU_SECRET=""

# 运行 Producer 服务
CMD ["python", "producer.py"]
